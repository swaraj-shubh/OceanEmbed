# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Only the download scripts read these. Training, evaluation and the demo run entirely
# from data/processed/ and need no credentials at all.

# NASA Earthdata -- SMAP SSS and OSCAR currents via PO.DAAC (src/download/podaac.py)
# Register (free): https://urs.earthdata.nasa.gov/users/new
# Then generate a token at: https://urs.earthdata.nasa.gov/profile -> Generate Token
EARTHDATA_TOKEN=

# Copernicus Marine -- SLA, winds, and the GLORYS12V1 target (src/download/cmems.py)
# Register (free): https://data.marine.copernicus.eu/register
COPERNICUSMARINE_SERVICE_USERNAME=
COPERNICUSMARINE_SERVICE_PASSWORD=

# Optional -- only if you mirror checkpoints to your own bucket (deploy/sync_checkpoints.sh).
# AWS credentials themselves come from `aws configure`, never from this file.
# BUCKET=oceanembed-sih26-data
# PREFIX=oceanembed
