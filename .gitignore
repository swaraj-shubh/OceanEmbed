# Data and model artifacts -- reproducible, or mirrored to S3.
# NOTE: .gitignore has no trailing comments. A pattern line is the whole line.
data/
checkpoints/
*.zarr/

# Prediction cubes are 0.3-0.7 GB each. The metric CSVs in results/ ARE tracked.
results/*.nc

# Credentials
.env
.env*

# Run logs (nohup output from downloads, training, site builds)
*.log
*.err

# Tooling
__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store
.vercel
.vercel/
